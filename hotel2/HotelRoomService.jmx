          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="My JSR223 Assertion" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.util.XmlSlurper

def responseText = prev.getResponseDataAsString()
def xml = new XmlSlurper().parseText(responseText)

def found = false
def correctPrice = false
def actualPrice = &quot;&quot;

xml.&apos;**&apos;.findAll { it.name() == &apos;room&apos; }.each { room -&gt;
    if (room.roomId.text() == &apos;101&apos;) {
        found = true
        actualPrice = room.roomPrice.text()
        if (actualPrice == &apos;1500.0&apos;) {
            correctPrice = true
        }
    }
}

if (found &amp;&amp; correctPrice) {
    log.info(&quot;roomId 101 is successfully updated with roomPrice 1500.0&quot;)
    AssertionResult.setFailure(false)
} else if (found &amp;&amp; !correctPrice) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;roomId 101 exists but has incorrect roomPrice: &quot; + actualPrice)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;roomId 101 is not found in the response!&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
